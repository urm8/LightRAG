const fs = require('fs');

const prompts = JSON.parse(
  fs.readFileSync('evals/prompts.active.json', 'utf8')
);

function fill(template, vars) {
  return template
    .replaceAll('{entity_types}', vars.entity_types || 'Person, Organization, Location, Event, Concept, Method, Content, Data, Artifact, Workspace, Project, Repository, Directory, File, ProgrammingLanguage, TechnologyStack, Framework, Library, Runtime, Service, Deployment, Environment, Configuration, Command, APIEndpoint, Database, StorageBackend, Other')
    .replaceAll('{language}', vars.language || 'English')
    .replaceAll('{tuple_delimiter}', prompts.tuple_delimiter)
    .replaceAll('{completion_delimiter}', prompts.completion_delimiter)
    .replaceAll('{input_text}', vars.input_text || '');
}

function sanitizeApfelInput(text) {
  return String(text || '')
    .split('\n')
    .map((line) => {
      const trimmed = line.trim();
      if (trimmed.startsWith('|') && trimmed.endsWith('|')) {
        return trimmed.replaceAll('|', ' ; ');
      }
      if (trimmed.startsWith('```')) {
        return '';
      }
      return line;
    })
    .join('\n');
}

function shouldSkipApfelInput(text) {
  const raw = String(text || '');
  return raw.includes('```') || raw.includes('<|#|>') || raw
    .split('\n')
    .some((line) => {
      const trimmed = line.trim();
      return trimmed.startsWith('|') && trimmed.endsWith('|');
    });
}

class ApfelLightRagExtractionProvider {
  id() {
    return 'apfel-lightrag-extraction';
  }

  async callApi(prompt, context) {
    const vars = context.vars || {};

    const baseUrl = process.env.APFEL_OPENAI_BASE_URL || 'http://127.0.0.1:11435/v1';
    const apiKey = process.env.APFEL_OPENAI_API_KEY || 'dummy';
    const model = process.env.APFEL_MODEL || 'apple-foundationmodel';
    const providerSystemPrompt = process.env.APFEL_SYSTEM_PROMPT || '';
    if (shouldSkipApfelInput(vars.input_text || '')) {
      return { output: prompts.completion_delimiter };
    }

    const safeVars = {
      ...vars,
      input_text: sanitizeApfelInput(vars.input_text || ''),
    };

    const system = [providerSystemPrompt, fill(prompts.system, safeVars)]
      .filter(Boolean)
      .join('\n\n');
    const user = fill(prompts.user, safeVars);

    const res = await fetch(`${baseUrl}/chat/completions`, {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${apiKey}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model,
        messages: [
          { role: 'system', content: system },
          { role: 'user', content: user },
        ],
        temperature: 0,
        max_tokens: Number(process.env.APFEL_MAX_TOKENS || '512'),
      }),
    });

    if (!res.ok) {
      const text = await res.text();
      return {
        error: `APFEL HTTP ${res.status}: ${text}`,
      };
    }

    const json = await res.json();
    return {
      output: json.choices?.[0]?.message?.content || '',
    };
  }
}

module.exports = ApfelLightRagExtractionProvider;
